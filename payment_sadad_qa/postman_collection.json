{
	"info": {
		"_postman_id": "c1a2b3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
		"name": "SADAD QA Odoo Integration Tests",
		"description": "A collection to test the SADAD payment provider integration for Odoo.\n\n**Setup**:\n1. Create a Postman Environment.\n2. Add the following variables:\n   - `base_url`: Your Odoo instance's URL (e.g., `http://localhost:8069`).\n   - `secret_key`: Your SADAD Test Secret Key.\n   - `order_id`: The reference of an existing 'draft' transaction in Odoo (e.g., `SO001-TX-001`).\n3. The `checksumhash` is calculated automatically by the pre-request script.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "[Callback] Success",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Pre-request script to generate SADAD checksumhash",
							"const CryptoJS = require('crypto-js');",
							"",
							"// Get variables from Postman environment",
							"const secretKey = pm.environment.get('secret_key');",
							"const requestBody = pm.request.body.urlencoded;",
							"",
							"// Get all keys from the form data",
							"let params = {};",
							"requestBody.each(param => {",
							"    if (!param.disabled && param.key !== 'checksumhash') {",
							"        params[param.key] = pm.variables.replaceIn(param.value);",
							"    }",
							"});",
							"",
							"// Sort keys alphabetically",
							"const sortedKeys = Object.keys(params).sort();",
							"",
							"// Concatenate values",
							"let concatenatedValues = '';",
							"sortedKeys.forEach(key => {",
							"    concatenatedValues += params[key];",
							"});",
							"",
							"// Prepend secret key and hash",
							"const stringToHash = secretKey + concatenatedValues;",
							"const hash = CryptoJS.SHA256(stringToHash).toString(CryptoJS.enc.Hex);",
							"",
							"// Set the hash as an environment variable to be used in the request",
							"pm.environment.set('checksumhash', hash);",
							"console.log('Generated Checksum:', hash);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "urlencoded",
					"urlencoded": [
						{"key": "ORDERID", "value": "{{order_id}}", "type": "text"},
						{"key": "TXNAMOUNT", "value": "150.00", "type": "text"},
						{"key": "STATUS", "value": "TXN_SUCCESS", "type": "text"},
						{"key": "RESPCODE", "value": "1", "type": "text"},
						{"key": "TXNID", "value": "SADAD-TEST-12345", "type": "text"},
						{"key": "checksumhash", "value": "{{checksumhash}}", "type": "text"}
					]
				},
				"url": {
					"raw": "{{base_url}}/payment/sadad/return",
					"host": ["{{base_url}}"],
					"path": ["payment", "sadad", "return"]
				}
			},
			"response": []
		},
		{
			"name": "[Callback] Failed",
			"event": [
				{"listen": "prerequest", "script": {"exec": ["// (Same pre-request script as Success callback)"], "type": "text/javascript"}}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "urlencoded",
					"urlencoded": [
						{"key": "ORDERID", "value": "{{order_id}}", "type": "text"},
						{"key": "TXNAMOUNT", "value": "150.00", "type": "text"},
						{"key": "STATUS", "value": "TXN_FAILED", "type": "text"},
						{"key": "RESPCODE", "value": "0", "type": "text"},
						{"key": "TXNID", "value": "SADAD-TEST-54321", "type": "text"},
						{"key": "checksumhash", "value": "{{checksumhash}}", "type": "text"}
					]
				},
				"url": {
					"raw": "{{base_url}}/payment/sadad/return",
					"host": ["{{base_url}}"],
					"path": ["payment", "sadad", "return"]
				}
			},
			"response": []
		},
		{
			"name": "[Webhook] Success",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Pre-request script for JSON body",
							"const CryptoJS = require('crypto-js');",
							"const secretKey = pm.environment.get('secret_key');",
							"const requestBody = JSON.parse(pm.request.body.raw);",
							"",
							"let params = {};",
							"Object.keys(requestBody).forEach(key => {",
							"    if (key !== 'checksumhash') {",
							"        params[key] = pm.variables.replaceIn(requestBody[key]);",
							"    }",
							"});",
							"",
							"const sortedKeys = Object.keys(params).sort();",
							"let concatenatedValues = '';",
							"sortedKeys.forEach(key => { concatenatedValues += params[key]; });",
							"",
							"const stringToHash = secretKey + concatenatedValues;",
							"const hash = CryptoJS.SHA256(stringToHash).toString(CryptoJS.enc.Hex);",
							"pm.environment.set('checksumhash', hash);",
							"",
							"// We need to update the raw body with the new hash",
							"requestBody.checksumhash = hash;",
							"pm.request.body.raw = JSON.stringify(requestBody);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [{"key": "Content-Type", "value": "application/json"}],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"websiteRefNo\": \"{{order_id}}\",\n    \"transactionNumber\": \"SADAD-WH-98765\",\n    \"txnAmount\": 150.00,\n    \"transactionStatus\": 3,\n    \"checksumhash\": \"{{checksumhash}}\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/payment/sadad/notify",
					"host": ["{{base_url}}"],
					"path": ["payment", "sadad", "notify"]
				}
			},
			"response": []
		},
		{
			"name": "[Webhook] Failed",
			"event": [
				{"listen": "prerequest", "script": {"exec": ["// (Same pre-request script as Success webhook)"], "type": "text/javascript"}}
			],
			"request": {
				"method": "POST",
				"header": [{"key": "Content-Type", "value": "application/json"}],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"websiteRefNo\": \"{{order_id}}\",\n    \"transactionNumber\": \"SADAD-WH-11223\",\n    \"txnAmount\": 150.00,\n    \"transactionStatus\": 2,\n    \"checksumhash\": \"{{checksumhash}}\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/payment/sadad/notify",
					"host": ["{{base_url}}"],
					"path": ["payment", "sadad", "notify"]
				}
			},
			"response": []
		}
	],
	"event": [
		{"listen": "prerequest", "script": {"type": "text/javascript", "exec": [""]}},
		{"listen": "test", "script": {"type": "text/javascript", "exec": [""]}}
	],
	"variable": []
}
