<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Action for the standalone settings view (unchanged) -->
        <record id="action_sadad_config_settings" model="ir.actions.act_window">
            <field name="name">SADAD Settings</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">inline</field>
            <field name="context">{'module' : 'payment_sadad_qa', 'bin_size': False}</field>
            <field name="view_id" ref="payment_sadad_qa.sadad_config_settings_view_form"/>
        </record>

        <!-- 1. NEW: Top-level menu for the SADAD Application -->
        <record id="menu_sadad_qa_root" model="ir.ui.menu">
            <field name="name">SADAD</field>
            <field name="sequence">100</field>
            <!-- A web_icon can be added here for the app switcher -->
        </record>

        <!-- 2. CHANGED: Settings menu is now a child of our new top-level menu -->
        <record id="menu_sadad_qa_settings" model="ir.ui.menu">
            <field name="name">Settings</field>
            <field name="parent_id" ref="payment_sadad_qa.menu_sadad_qa_root"/>
            <field name="action" ref="payment_sadad_qa.action_sadad_config_settings"/>
            <field name="sequence">10</field>
        </record>

        <!-- Menu item for the Reconciliation Wizard -->
        <record id="menu_sadad_qa_reconciliation" model="ir.ui.menu">
            <field name="name">Reconciliation</field>
            <field name="parent_id" ref="payment_sadad_qa.menu_sadad_qa_root"/>
            <field name="action" ref="payment_sadad_qa.action_sadad_recon_wizard"/>
            <field name="sequence">20</field>
        </record>
    </data>
</odoo>
