<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- This template's structure is based on the user's working example -->
        <template id="sadad_form">
            <form t-att-action="api_url" method="post" name="gosadad" target="_self">
                <!-- Basic fields from the sadad_values dictionary -->
                <input type="hidden" name="CALLBACK_URL" t-att-value="sadad_values.get('CALLBACK_URL')"/>
                <input type="hidden" name="EMAIL" t-att-value="sadad_values.get('EMAIL')"/>
                <input type="hidden" name="MOBILE_NO" t-att-value="sadad_values.get('MOBILE_NO')"/>
                <input type="hidden" name="ORDER_ID" t-att-value="sadad_values.get('ORDER_ID')"/>
                <input type="hidden" name="TXN_AMOUNT" t-att-value="sadad_values.get('TXN_AMOUNT')"/>
                <input type="hidden" name="WEBSITE" t-att-value="sadad_values.get('WEBSITE')"/>
                <input type="hidden" name="merchant_id" t-att-value="sadad_values.get('merchant_id')"/>
                <input type="hidden" name="txnDate" t-att-value="sadad_values.get('txnDate')"/>
                <input type="hidden" name="SADAD_WEBCHECKOUT_PAGE_LANGUAGE" t-att-value="sadad_values.get('SADAD_WEBCHECKOUT_PAGE_LANGUAGE')"/>

                <!-- The signature is now a top-level variable -->
                <input type="hidden" name="signature" t-att-value="signature"/>

                <!-- Product details using the t-attf-name syntax -->
                <t t-foreach="sadad_values.get('productdetail', [])" t-as="product_line">
                    <t t-set="index" t-value="product_line_index"/>
                    <input type="hidden" t-attf-name="productdetail[#{index}][order_id]" t-att-value="product_line.get('order_id')"/>
                    <input type="hidden" t-attf-name="productdetail[#{index}][amount]" t-att-value="product_line.get('amount')"/>
                    <input type="hidden" t-attf-name="productdetail[#{index}][quantity]" t-att-value="product_line.get('quantity')"/>
                    <input type="hidden" t-attf-name="productdetail[#{index}][itemname]" t-att-value="product_line.get('itemname')"/>
                </t>
            </form>
            <script>
                document.gosadad.submit();
            </script>
            <p>Please wait, you are being redirected to the SADAD payment page...</p>
        </template>
    </data>
</odoo>
