<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_sadad_qa" model="ir.ui.view">
        <field name="name">payment.provider.form.sadad</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="after">
                <group attrs="{'invisible': [('code', '!=', 'sadad_qa')]}">
                    <div class="alert alert-info" role="alert">
                        <strong>Configuration Note:</strong>
                        <p>
                            SADAD Merchant ID, Secret Keys, and Environment settings are managed centrally.
                            Please configure them under:
                            <br/>
                            <strong>Website ‣ Configuration ‣ SADAD Settings</strong>.
                        </p>
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
