<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
        This is a standalone view for SADAD settings.
        It does not inherit from any other view to avoid XPath errors.
        -->
        <record id="sadad_config_settings_view_form" model="ir.ui.view">
            <field name="name">sadad.config.settings.view.form</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="99"/>
            <field name="arch" type="xml">
                <form class="oe_form_configuration">
                    <header>
                        <button string="Apply" type="object" name="execute" class="btn-primary"/>
                        <button string="Cancel" type="object" name="cancel" class="btn-secondary" special="cancel"/>
                    </header>
                    <sheet>
                        <div class="app_settings_block" data-string="SADAD" string="SADAD" data-key="payment_sadad_qa">
                            <h2>SADAD (Qatar) Settings</h2>
                            <div class="row mt16 o_settings_container" id="sadad_qa_settings">
                                <div class="col-12 col-lg-6 o_setting_box">
                                    <div class="o_setting_right_pane">
                                        <label for="sadad_merchant_id"/>
                                        <div class="text-muted">
                                            Your official Merchant ID from the SADAD Panel.
                                        </div>
                                        <div class="content-group">
                                            <div class="mt16">
                                                <field name="sadad_merchant_id" class="o_website_form_input"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-6 o_setting_box">
                                    <div class="o_setting_right_pane">
                                        <label for="sadad_environment"/>
                                        <div class="text-muted">
                                            Switch between Test and Production environments.
                                        </div>
                                        <div class="content-group">
                                            <div class="mt16">
                                                <field name="sadad_environment" widget="radio"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-6 o_setting_box">
                                    <div class="o_setting_right_pane">
                                        <label for="sadad_test_secret"/>
                                        <div class="text-muted">
                                            Secret key for the <strong>Test</strong> environment.
                                        </div>
                                        <div class="content-group">
                                            <div class="mt16">
                                                <field name="sadad_test_secret" password="True"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-6 o_setting_box">
                                    <div class="o_setting_right_pane">
                                        <label for="sadad_live_secret"/>
                                        <div class="text-muted">
                                            Secret key for the <strong>Production</strong> environment.
                                        </div>
                                        <div class="content-group">
                                            <div class="mt16">
                                                <field name="sadad_live_secret" password="True"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-6 o_setting_box">
                                   <div class="o_setting_right_pane">
                                       <label for="sadad_language"/>
                                       <div class="text-muted">
                                           Default language for the SADAD checkout page.
                                       </div>
                                       <div class="content-group">
                                           <div class="mt16">
                                               <field name="sadad_language" widget="radio"/>
                                           </div>
                                       </div>
                                   </div>
                                </div>
                                <div class="col-12 col-lg-6 o_setting_box">
                                    <div class="o_setting_left_pane"/>
                                    <div class="o_setting_right_pane">
                                        <div class="content-group">
                                            <div class="mt16">
                                                <field name="sadad_debug" class="o_light_label"/>
                                                <label for="sadad_debug"/>
                                            </div>
                                            <div class="text-muted">
                                                Log requests and responses for debugging. Do not use in production.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-6 o_setting_box">
                                    <div class="o_setting_right_pane">
                                        <label for="sadad_website_domain"/>
                                        <div class="text-muted">
                                            Manually set the Website Domain for SADAD requests.
                                        </div>
                                        <div class="content-group">
                                            <div class="mt16">
                                                <field name="sadad_website_domain" placeholder="e.g. www.yourstore.com"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-6 o_setting_box">
                                    <div class="o_setting_right_pane">
                                        <label for="sadad_default_mobile"/>
                                        <div class="text-muted">
                                            Fallback mobile number if customer's is missing.
                                        </div>
                                        <div class="content-group">
                                            <div class="mt16">
                                                <field name="sadad_default_mobile" placeholder="e.g. 97412345678"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
